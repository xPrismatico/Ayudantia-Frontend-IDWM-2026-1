{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "endOfLine": "lf",
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/types/domain(/.*)?$",
    "^@/types(/.*)?$",
    "^@/lib(/.*)?$",
    "^@/components/ui(/.*)?$",
    "^@/components/shared(/.*)?$",
    "^@/components(/.*)?$",
    "^@/views(/.*)?$",
    "^@/data(/.*)?$",
    "^@/(.*)$",
    "",
    "^[./]"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrderTypeScriptVersion": "5.0.0"
}
